# Everything left empty is auto-generated on first start (stored in the data volume).
APP_NAME=Jinx Data
ENVIRONMENT=production
DATABASE_URL=sqlite:///./data/subhub.db
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
SUBSCRIPTION_HMAC_KEY=
CREDENTIALS_ENCRYPTION_KEY=
# Empty = http://localhost:$PORT. Set to your real http://IP:PORT or https://domain.
PUBLIC_BASE_URL=
CORS_ORIGINS=
OPENAPI_ENABLED=false
PANEL_ALLOW_PRIVATE_ADDRESSES=true
SYNC_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
# WARNING: Docker Compose treats $ in .env values as a variable. Use letters/digits only for
# passwords, or wrap the value in single quotes: INITIAL_ADMIN_PASSWORD='abc$123'
# Empty username = admin; empty password = random, saved to /app/data/initial-admin.txt
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# Login lock: 5 failed tries per IP+username => 15 min. Set false only for testing.
LOGIN_RATE_LIMIT_ENABLED=true
# Extra username-only lock across all IPs (distributed brute force): N failures => locked for LOGIN_USER_LOCK_SECONDS, then it expires.
LOGIN_USER_MAX_ATTEMPTS=20
LOGIN_USER_LOCK_SECONDS=900
# Panel host port (change if 8000 is taken)
PANEL_PORT=8000
# Host interface for the panel port. Use 127.0.0.1 when a reverse proxy (nginx/Caddy/Cloudflare tunnel) is in front.
PANEL_BIND=0.0.0.0
# Proxy headers (CF-Connecting-IP, X-Real-IP, X-Forwarded-For) are IGNORED by default. Enable only behind a proxy,
# and list the proxy's address(es) (comma-separated IPs/CIDRs): headers are trusted only from those direct peers.
# Example (proxy on the host, Docker bridge): TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
# Separate subscription port (own listener; the sub page cannot reveal the panel address).
# Leave SUB_PORT empty to serve /sub on the panel port (old behaviour).
SUB_PORT=
SUB_BIND=0.0.0.0
SUB_PUBLIC_BASE_URL=
# Domains for SSL (set by the terminal menu: option 17). Panel answers only on PANEL_DOMAIN when set.
PANEL_DOMAIN=
SUB_DOMAIN=
# Delete usage/audit log rows older than N days (0 = keep forever)
LOG_RETENTION_DAYS=180
# Slow network: NPM_REGISTRY=https://registry.npmmirror.com  PIP_INDEX_URL=...
NPM_REGISTRY=
PIP_INDEX_URL=

# Notifications (all optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
WEBHOOK_URL=
WEBHOOK_SECRET=
EXPIRY_WARN_DAYS=3
# Delete users this many days after expiry (0 = never)
AUTO_DELETE_EXPIRED_DAYS=0
