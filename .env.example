APP_NAME=SubHub
ENVIRONMENT=production
DATABASE_URL=sqlite:///./data/subhub.db
JWT_SECRET=replace-with-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=60
SUBSCRIPTION_HMAC_KEY=replace-with-a-separate-random-secret-at-least-32-chars
CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-key
PUBLIC_BASE_URL=https://subhub.example.com
CORS_ORIGINS=https://subhub.example.com
OPENAPI_ENABLED=true
PANEL_ALLOW_PRIVATE_ADDRESSES=true
SYNC_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
PORT=8000
